# ========== MongoDB 配置 ==========
MONGO_USER=autolib
MONGO_PASS=请修改为强密码

# ========== Flask API 端口 ==========
API_PORT=5004

# ========== Session 密钥（必须修改，用 openssl rand -hex 32 生成） ==========
SECRET_KEY=请运行: openssl rand -hex 32

# ========== Session Cookie 安全标志 ==========
# 走默认的 Caddy 部署（80 端口一律 308 跳 443）就保持 true。
# 只有在完全没有 HTTPS 的环境里才设为 false：Secure Cookie 在明文页面上会被
# Safari 等浏览器直接丢弃，表现为「验证成功但没登上」。
# 注意即使设成 false，登录也还有 Authorization: Bearer 令牌这条不依赖 Cookie 的路。
SESSION_COOKIE_SECURE=true

# ========== 信任的反向代理层数 ==========
# 默认部署（Caddy → flask-api）保持 1，接口限流才能按访问者真实 IP 计数。
# 如果把 Flask 直接暴露到公网，必须改成 0，否则可以伪造 X-Forwarded-For 绕过限流。
TRUSTED_PROXY_COUNT=1

# ========== 凭据加密密钥（64位hex，用 openssl rand -hex 32 生成） ==========
ENCRYPTION_KEY=请运行: openssl rand -hex 32

# ========== 管理员账号 ==========
# 首次部署后交互式初始化，不要把管理员明文密码写入 .env：
# docker compose exec flask-api python init_admin.py

# ========== 定时预约时间（每天几点几分执行预约） ==========
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=00

# ========== 并发抢座 ==========
# 7:00 同时开跑的账号数。调高能让排在后面的用户也赶上黄金窗口，
# 但 webvpn 网关和图书馆接口都有限流，一般 8~16 之间。
RESERVE_CONCURRENCY=8

# 午休功能总开关。0=关闭（默认）。
# 图书馆没有开放「离馆」接口，用户刷卡入座后预约删不掉，午休会中途失败，
# 所以整套功能暂时停用。接上离馆接口后改成 1，并同步把 static/app.js 里的
# NAP_DISABLED 改成 false。
NAP_ENABLED=0

# ========== 提前预约窗口 / 占位抢座 ==========
# 图书馆规则（resvRule）：一个时段最早只能提前 earliestResvTime 分钟下单，而且是相对
# 「预约开始时间」算的。2026-09-07 用真实下单实测过：提前 1859.7 分钟成功、1860.7 分钟
# 被拒，卡点就是 1860 分钟整（31 小时），并且逐秒滑动。改这个值等于赌图书馆改了规则。
EARLIEST_RESV_MINUTES=1860
# 因为是逐秒判定，下单时刻要离边界退一点余量；踩着线发、本机时钟又比图书馆快几秒，
# 换来的就是一句「不在提前预约时间范围内」和一个白白烧掉的时段。
RESV_WINDOW_MARGIN_SECONDS=120
# resvRule.maxResvTime / minResvTime：单次预约的时长上下限（分钟）。
MAX_RESV_MINUTES=900
MIN_RESV_MINUTES=120
# 开馆时间，占位预约的起点不能早于它。
LIBRARY_OPEN_TIME=07:30
# 占位抢座总开关。1=开（默认）：超窗的时段不再干等，先下一张「起点顶到 31 小时窗口边界、
# 终点就是本段终点」的预约把座位占住——它完整盖住目标时段，别人插不进来；等目标时段
# 自己进了窗口，再取消占位、立刻改约成精确时段，并回图书馆核对确实换过来了。
# 0=关：退回「超窗只排队、到点再抢」的老行为（座位可能早被别人约走）。
SEGMENT_HOLD_ENABLED=1
# 换约失败后一直重试，直到占位预约开始前这么多分钟；之后才放弃并告警。
# 绝不能一失败就收尾——那等于默认接受了那张开始时间比配置更早的占位预约。
SEGMENT_SWAP_DEADLINE_MINUTES=30
# 换约重试节奏：前几次每分钟一次，之后每隔多少分钟一次（要试二十多个小时，不能每分钟登一次）
SEGMENT_SWAP_FAST_ATTEMPTS=5
SEGMENT_SWAP_SLOW_INTERVAL_MINUTES=10
# 没占上位的段补约失败后最多再试这么多次（每分钟一次）。只为吃掉窗口边界、网络、
# 登录那几种一次性抖动；重试要重走一遍 webvpn + CAS，所以必须有上限。
SEGMENT_RETRY_MAX_ATTEMPTS=10

# ========== 预登录 ==========
# 抢座的时间几乎全花在登录上：webvpn + CAS 要 4~8 秒，真正的预约请求往返只有 200~300 毫秒。
# 图书馆 7:00 才开放预约，但认证接口全天可用，所以提前把登录跑完，7:00 直接发预约请求。
# 预登录失败不影响抢座，只是退回到 7:00 现场登录（也就是没有这个功能时的行为）。
PRELOGIN_ENABLED=1
# 提前多少分钟做全量预登录
PRELOGIN_LEAD_MINUTES=10
# 提前多少秒复查会话，把已失效的重登一遍（这时候重登还来得及）
PRELOGIN_REFRESH_LEAD_SECONDS=30
# 会话在池子里的最长存活时间，超过就丢弃重登，防止调度异常时用到僵尸会话
PRELOGIN_MAX_AGE_SECONDS=1800
# 距上次校验不到这么久的会话 7:00 直接用，省掉一个来回；会话真死了下单时会现场重登
PRELOGIN_VERIFY_FRESH_SECONDS=120
# 撞上图书馆的账号级锁（「您有预约操作正在进行」）时，等多久再打同一张座位、最多几次
RESERVE_BUSY_RETRY_DELAY_SECONDS=0.4
RESERVE_BUSY_RETRY_MAX=3
# 会话校验的超时。卡住比失败更糟——失败只是回退现场登录，卡住会把抢座窗口拖没
SESSION_VERIFY_CONNECT_TIMEOUT=3
SESSION_VERIFY_READ_TIMEOUT=5

# ==================== 座位占用快照 ====================
# 一个早上拍三张全馆占用快照，把 7:00 那一秒夹在中间。竞争度只存在于差里：
#   rush - pre  = 7:00 那一波真抢走的（抢不过的）
#   post - rush = 之后慢慢约走的（我们本来拿得到的）
# 只读 ic-web，不改任何用户配置。数据落在 seat_snapshots 集合。
SEAT_SNAPSHOT_ENABLED=1
# 抢座前多少分钟拍第一张（默认 6:45）。必须早于 6:50 的预登录，别抢网关
SEAT_SNAPSHOT_PRE_MINUTES=15
# 抢座后多少秒拍第二张（默认 7:01）。抢座本身 6~15 秒跑完，这张定格「谁抢赢了」
# 它复用 6:45 那次登录的会话，抢座窗口里不会产生任何新登录
SEAT_SNAPSHOT_RUSH_SECONDS=60
# 抢座后多少分钟拍第三张（默认 7:05）
SEAT_SNAPSHOT_DELAY_MINUTES=5
# 抢座后多少分钟把三张压成一条「全馆预约概况」（默认 7:10），设置页的折线图读它。
# 只读库不访问图书馆；数据落在 seat_occupancy_daily 集合，一天一条，永久保留
SEAT_OCCUPANCY_STATS_DELAY_MINUTES=10
# 每晚几点把当天的「预约时长」换成真实在馆时长（默认 22:10，闭馆之后）。
# 只处理在设置页勾了「真实在馆时长」的用户，逐个慢慢拉图书馆的操作流水
STUDY_TIME_SYNC_AT=22:10
# 观测账号：只用它发 GET 查占用，不参与抢座。
# 必须填一个已在本站验证过的学号，留空则整套快照任务直接跳过。
SEAT_SNAPSHOT_PID=你的观测账号学号

# ========== HTTP 超时 ==========
# requests 默认不设超时，一个不响应的上游能把线程永久挂住，
# 并发抢座时会导致当天的定时任务永远结束不了。
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
LIBRARY_LOGIN_MAX_ATTEMPTS=3
LIBRARY_LOGIN_RETRY_DELAY_SECONDS=2

# 两封通知之间的最小间隔（秒）。并发抢座会让邮件挤在同一秒，
# Resend 免费额度是每秒 2 封，超出的会被丢弃。
NOTIFY_MIN_INTERVAL=0.6

# ========== 学校闭馆公告监控 ==========
# scheduler 每天北京时间 20:00 检查，20:05 / 20:15 只在当天首次失败时补偿。
# API Key 只能放服务端 .env，禁止写进网页或 Android 安装包。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 审核邮件中用于生成可点击的后台深链，例如 https://你的域名
PUBLIC_BASE_URL=
# 每次只抓公告列表最前面的若干条；首次运行仅建立水位，不追发旧公告。
SCHOOL_NOTICE_SCAN_LIMIT=20
SCHOOL_NOTICE_MAX_BYTES=1048576

# ========== 邮件通知（Resend 优先，SMTP 作为回退） ==========
# 测试阶段 onboarding@resend.dev 只能发到 Resend 账号绑定邮箱。
# 已验证自有域名（如 mail.example.com）后，把 RESEND_FROM 改为该域名的发件人。
RESEND_API_KEY=
RESEND_FROM=AutoLib <noreply@mail.example.com>

# 可选 SMTP 回退。Outlook 使用 587/STARTTLS；SMTP_PASS 使用应用专用密码。
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ========== 「联系方式」卡片 ==========
# 部署者自己的联系方式，留空的条目不显示，三个都留空则整张卡片不渲染。
CONTACT_EMAIL=
CONTACT_QQ=
CONTACT_GITHUB=

# ---- 构建镜像站（可选）----
# 境内机器 docker compose build 时 apt / pip 走官方源极慢，填镜像站能快 5 倍以上。
# 境外或不在乎的留空即可，默认官方源。
APT_MIRROR=
PIP_INDEX_URL=
