# ========== MongoDB 配置 ==========
MONGO_USER=autolib
MONGO_PASS=请修改为强密码

# ========== Flask API 端口 ==========
API_PORT=5004

# ========== Session 密钥（必须修改，用 openssl rand -hex 32 生成） ==========
SECRET_KEY=请运行: openssl rand -hex 32

# ========== Session Cookie 安全标志 ==========
# 通过 HTTP 直接访问时设为 false；配置了 HTTPS 反代时设为 true
SESSION_COOKIE_SECURE=false

# ========== 信任的反向代理层数 ==========
# 默认部署（Caddy → flask-api）保持 1，接口限流才能按访问者真实 IP 计数。
# 如果把 Flask 直接暴露到公网，必须改成 0，否则可以伪造 X-Forwarded-For 绕过限流。
TRUSTED_PROXY_COUNT=1

# ========== 凭据加密密钥（64位hex，用 openssl rand -hex 32 生成） ==========
ENCRYPTION_KEY=请运行: openssl rand -hex 32

# ========== 管理员账号 ==========
# 首次部署后交互式初始化，不要把管理员明文密码写入 .env：
# docker compose exec flask-api python init_admin.py

# ========== 定时预约时间（每天几点几分执行预约） ==========
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=00

# ========== 并发抢座 ==========
# 7:00 同时开跑的账号数。调高能让排在后面的用户也赶上黄金窗口，
# 但 webvpn 网关和图书馆接口都有限流，一般 8~16 之间。
RESERVE_CONCURRENCY=8

# ========== 预登录 ==========
# 抢座的时间几乎全花在登录上：webvpn + CAS 要 4~8 秒，真正的预约请求往返只有 200~300 毫秒。
# 图书馆 7:00 才开放预约，但认证接口全天可用，所以提前把登录跑完，7:00 直接发预约请求。
# 预登录失败不影响抢座，只是退回到 7:00 现场登录（也就是没有这个功能时的行为）。
PRELOGIN_ENABLED=1
# 提前多少分钟做全量预登录
PRELOGIN_LEAD_MINUTES=10
# 提前多少秒复查会话，把已失效的重登一遍（这时候重登还来得及）
PRELOGIN_REFRESH_LEAD_SECONDS=30
# 会话在池子里的最长存活时间，超过就丢弃重登，防止调度异常时用到僵尸会话
PRELOGIN_MAX_AGE_SECONDS=1800
# 会话校验的超时。卡住比失败更糟——失败只是回退现场登录，卡住会把抢座窗口拖没
SESSION_VERIFY_CONNECT_TIMEOUT=3
SESSION_VERIFY_READ_TIMEOUT=5

# ========== HTTP 超时 ==========
# requests 默认不设超时，一个不响应的上游能把线程永久挂住，
# 并发抢座时会导致当天的定时任务永远结束不了。
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
LIBRARY_LOGIN_MAX_ATTEMPTS=3
LIBRARY_LOGIN_RETRY_DELAY_SECONDS=2

# 两封通知之间的最小间隔（秒）。并发抢座会让邮件挤在同一秒，
# Resend 免费额度是每秒 2 封，超出的会被丢弃。
NOTIFY_MIN_INTERVAL=0.6

# ========== 学校闭馆公告监控 ==========
# scheduler 每天北京时间 20:00 检查，20:05 / 20:15 只在当天首次失败时补偿。
# API Key 只能放服务端 .env，禁止写进网页或 Android 安装包。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 审核邮件中用于生成可点击的后台深链，例如 https://你的域名
PUBLIC_BASE_URL=
# 每次只抓公告列表最前面的若干条；首次运行仅建立水位，不追发旧公告。
SCHOOL_NOTICE_SCAN_LIMIT=20
SCHOOL_NOTICE_MAX_BYTES=1048576

# ========== 邮件通知（Resend 优先，SMTP 作为回退） ==========
# 测试阶段 onboarding@resend.dev 只能发到 Resend 账号绑定邮箱。
# 已验证自有域名（如 mail.example.com）后，把 RESEND_FROM 改为该域名的发件人。
RESEND_API_KEY=
RESEND_FROM=AutoLib <noreply@mail.example.com>

# 可选 SMTP 回退。Outlook 使用 587/STARTTLS；SMTP_PASS 使用应用专用密码。
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
